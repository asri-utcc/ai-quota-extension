{
  "manifest_version": 3,
  "name": "AI Usage Monitor (Claude, Gemini, MiniMax & Codex)",
  "version": "1.3.0",
  "description": "Monitor 5-hour rolling and weekly usage limits for Claude, Gemini Pro, MiniMax, and OpenAI Codex with sidebar and custom visibility support.",
  "permissions": [
    "cookies",
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "popup.html?view=sidepanel"
  },
  "host_permissions": [
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://*.google.com/*",
    "https://*.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://api.openai.com/*",
    "https://*.openai.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://api.minimax.io/*",
    "https://www.minimax.io/*",
    "https://platform.minimax.io/*",
    "https://api.minimaxi.chat/*",
    "https://api.minimaxi.com/*",
    "https://www.minimaxi.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Usage Monitor",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
